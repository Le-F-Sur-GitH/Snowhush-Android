<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- No permissions at all. The snow is a live wallpaper, which needs none, and nothing here reaches the network:
         the app can't send anything anywhere. -->

    <uses-feature android:glEsVersion="0x00030000" android:required="true" />
    <uses-feature android:name="android.software.live_wallpaper" android:required="true" />
    <uses-feature android:name="android.hardware.sensor.accelerometer" android:required="false" />

    <!-- Deep Interaction asks which app shows the home screen, to listen to that one alone. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.HOME" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales"
        android:supportsRtl="true"
        android:theme="@style/Snowhush">

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- The snow: on the home and lock screens, behind the apps. -->
        <service
            android:name=".SnowWallpaper"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_WALLPAPER">
            <intent-filter>
                <action android:name="android.service.wallpaper.WallpaperService" />
            </intent-filter>
            <meta-data
                android:name="android.service.wallpaper"
                android:resource="@xml/wallpaper" />
        </service>

        <!-- Deep Interaction: tells the wallpaper where the home screen's widgets and icons are. -->
        <service
            android:name=".DeepService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/deep" />
        </service>
    </application>
</manifest>
