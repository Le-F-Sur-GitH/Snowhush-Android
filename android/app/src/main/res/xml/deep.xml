<?xml version="1.0" encoding="utf-8"?>
<!-- Deep Interaction: Android tells the service when windows come, go and move, and where they are. It asks to
     retrieve windows because that is how Android names being told where they are; DeepService never asks for what
     is in one. It is no accessibility tool, and says so. -->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowsChanged|typeWindowStateChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagRetrieveInteractiveWindows"
    android:canRetrieveWindowContent="true"
    android:description="@string/deep_description"
    android:isAccessibilityTool="false"
    android:notificationTimeout="80"
    android:settingsActivity="app.snowhush.android.MainActivity"
    android:summary="@string/deep_summary" />
