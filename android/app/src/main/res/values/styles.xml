<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Always the night: the snow is white, and the app looks like its icon whatever the system's theme. -->
    <style name="Snowhush" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/night</item>
        <item name="android:colorBackground">@color/night</item>
        <item name="android:colorAccent">@color/ink</item>
        <item name="android:colorControlActivated">@color/ink</item>
        <item name="android:textColorPrimary">@color/ink</item>
        <item name="android:textColorSecondary">@color/muted</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
